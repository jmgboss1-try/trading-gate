//@version=6
// TradeGate RSI 다이버전스 — 가격 차트(캔들) 위에 RSI 다이버전스만 표시
// 차트에 추가하면 바로 캔들 위에 그려집니다. 창을 옮길 필요 없음.
// RSI 기간·소스·과매수/과매도 기준을 평소 RSI와 같게 맞추세요.
indicator("TradeGate RSI 다이버전스", shorttitle = "TG 다이버전스", overlay = true, max_labels_count = 500, max_lines_count = 500, max_bars_back = 500)

// ───────────── 입력 ─────────────
grpR = "RSI (평소 RSI와 같게)"
src   = input.source(close, "소스", group = grpR)
len   = input.int(14, "RSI 기간", minval = 2, group = grpR)
obLvl = input.int(70, "과매수 기준", minval = 50, maxval = 100, group = grpR)
osLvl = input.int(30, "과매도 기준", minval = 0, maxval = 50, group = grpR)

grpD = "다이버전스"
showReg  = input.bool(true, "상승/하락 다이버전스 (반전 신호)", group = grpD, tooltip = "상승 다이버전스: 가격은 저점을 낮추는데 RSI는 저점을 높임 → 반등 가능성\n하락 다이버전스: 가격은 고점을 높이는데 RSI는 고점을 낮춤 → 하락 가능성")
showHid  = input.bool(false, "H 다이버전스 (추세 지속 신호)", group = grpD, tooltip = "H 상승: 가격은 저점을 높이는데 RSI는 저점을 낮춤 → 상승 추세 지속\nH 하락: 가격은 고점을 낮추는데 RSI는 고점을 높임 → 하락 추세 지속\n조건: 시작점 RSI가 50 ± 허용값 안, 완성점 RSI가 과매도(H 상승) 또는 과매수(H 하락) 도달")
midTol   = input.float(4, "H 다이버전스 시작점: RSI 50 ± 허용", minval = 0, maxval = 15, step = 0.5, group = grpD, tooltip = "H 다이버전스 첫 번째 저점(고점)의 RSI가 50에서 이 값 이내여야 합니다. 예: 4 → 46~54")
showBull = input.bool(true, "상승 쪽 표시", group = grpD, inline = "side")
showBear = input.bool(true, "하락 쪽 표시", group = grpD, inline = "side")
needZone = input.bool(true, "과매도/과매수 터치 필수", group = grpD, tooltip = "상승 다이버전스는 두 저점 사이 구간에서 RSI가 과매도 기준 이하를, 하락 다이버전스는 과매수 기준 이상을 찍어야 표시 (H 다이버전스에는 적용 안 함)")
lbL      = input.int(5, "저점·고점 판단: 왼쪽 봉 수", minval = 1, group = grpD)
lbR      = input.int(3, "저점·고점 판단: 오른쪽 봉 수", minval = 1, group = grpD, tooltip = "저점(고점) 뒤로 이 봉 수만큼 지나야 확정됩니다. 작을수록 빠르지만 신호가 많아집니다.")
tol      = input.int(2, "RSI 저점 찾기 허용 봉", minval = 0, maxval = 5, group = grpD, tooltip = "가격 저점 앞뒤 이 봉 수 안에서 RSI 최저(최고)값을 찾습니다. 가격과 RSI의 저점이 1~2봉 어긋나는 경우를 잡기 위함")
rangeMin = input.int(5, "두 저점 사이 최소 봉", minval = 2, group = grpD)
rangeMax = input.int(60, "두 저점 사이 최대 봉", minval = 5, maxval = 200, group = grpD)

grpS = "표시"
labelMode = input.string("짧게", "라벨 글자", options = ["짧게", "전체", "숨김"], group = grpS, tooltip = "짧게: 상승 / 하락 / H 상승 / H 하락\n전체: 상승 다이버전스 / 하락 다이버전스 …\n숨김: 선만 표시")
labelSize = input.string("아주 작게", "라벨 크기", options = ["아주 작게", "작게"], group = grpS)
cBull     = input.color(#26d39a, "상승 색", group = grpS, inline = "col")
cBear     = input.color(#ff4d6d, "하락 색", group = grpS, inline = "col")
lineW     = input.int(1, "선 두께", minval = 1, maxval = 4, group = grpS, inline = "ln")
lineTr    = input.int(50, "선 투명도 %", minval = 0, maxval = 90, step = 10, group = grpS, inline = "ln", tooltip = "0 = 진하게, 90 = 거의 안 보임")
lineStyIn = input.string("실선", "선 모양 (일반 다이버전스)", options = ["실선", "점선", "짧은 점선"], group = grpS, tooltip = "H 다이버전스는 항상 긴 점선으로 그려 일반 다이버전스와 구분합니다")
regStyle  = lineStyIn == "점선" ? line.style_dashed : lineStyIn == "짧은 점선" ? line.style_dotted : line.style_solid

lblSize   = labelSize == "작게" ? size.small : size.tiny
onRsiPane = false // 가격 차트 전용
onPrice   = true

// ───────────── RSI ─────────────
rsi = ta.rsi(src, len)

// ───────────── 다이버전스 ─────────────
// 1) 저점·고점은 '가격'(심지 포함)에서 찾는다
// 2) 그 시점 ±tol봉 안의 RSI 최저·최고값과 비교한다
// 3) 두 점을 잇는 선을 사이 봉의 가격·RSI가 뚫으면 무효
// 4) 일반 다이버전스는 그 구간에서 RSI가 과매도/과매수를 찍어야 인정 (설정)
// 모든 ta.* 호출은 매 봉 실행되도록 조건식 밖에서 계산
plFound = not na(ta.pivotlow(low, lbL, lbR))
phFound = not na(ta.pivothigh(high, lbL, lbR))

tolE    = math.min(tol, lbR)
winLen  = 2 * tolE + 1
winOff  = lbR - tolE
winEnd  = bar_index - winOff
rsiLowNear   = ta.lowest(rsi, winLen)[winOff]
rsiHighNear  = ta.highest(rsi, winLen)[winOff]
rsiLowBar    = winEnd + ta.lowestbars(rsi, winLen)[winOff]
rsiHighBar   = winEnd + ta.highestbars(rsi, winLen)[winOff]

pivBar  = bar_index - lbR
curLow  = low[lbR]
curHigh = high[lbR]

prevBarPL  = ta.valuewhen(plFound, pivBar, 1)
prevLowPL  = ta.valuewhen(plFound, curLow, 1)
prevRsiPL  = ta.valuewhen(plFound, rsiLowNear, 1)
prevRBarPL = ta.valuewhen(plFound, rsiLowBar, 1)
prevBarPH  = ta.valuewhen(phFound, pivBar, 1)
prevHighPH = ta.valuewhen(phFound, curHigh, 1)
prevRsiPH  = ta.valuewhen(phFound, rsiHighNear, 1)
prevRBarPH = ta.valuewhen(phFound, rsiHighBar, 1)

RSI_SLACK = 1.0 // RSI 선 통과 허용 오차 (RSI 포인트)

// 두 저점을 잇는 선 아래로 사이 봉의 가격·RSI가 내려가지 않았는지 + 구간 RSI 최저값
checkLows(int x1, float p1, float r1, int x2, float p2, float r2) =>
    bool clean = true
    float minR = math.min(r1, r2)
    n = x2 - x1
    if n > 1
        for i = 1 to n - 1
            off  = bar_index - (x1 + i)
            t    = float(i) / n
            if low[off] < p1 + (p2 - p1) * t
                clean := false
            if rsi[off] < r1 + (r2 - r1) * t - RSI_SLACK
                clean := false
            minR := math.min(minR, rsi[off])
    [clean, minR]

// 두 고점을 잇는 선 위로 사이 봉의 가격·RSI가 올라가지 않았는지 + 구간 RSI 최고값
checkHighs(int x1, float p1, float r1, int x2, float p2, float r2) =>
    bool clean = true
    float maxR = math.max(r1, r2)
    n = x2 - x1
    if n > 1
        for i = 1 to n - 1
            off  = bar_index - (x1 + i)
            t    = float(i) / n
            if high[off] > p1 + (p2 - p1) * t
                clean := false
            if rsi[off] > r1 + (r2 - r1) * t + RSI_SLACK
                clean := false
            maxR := math.max(maxR, rsi[off])
    [clean, maxR]

gapPL = pivBar - prevBarPL
gapPH = pivBar - prevBarPH
bullBase = showBull and plFound and not na(prevBarPL) and gapPL >= rangeMin and gapPL <= rangeMax
bearBase = showBear and phFound and not na(prevBarPH) and gapPH >= rangeMin and gapPH <= rangeMax

bool  bullClean = false
float bullMinR  = na
if bullBase
    [c, m] = checkLows(int(prevBarPL), prevLowPL, prevRsiPL, pivBar, curLow, rsiLowNear)
    bullClean := c
    bullMinR  := m

bool  bearClean = false
float bearMaxR  = na
if bearBase
    [c, m] = checkHighs(int(prevBarPH), prevHighPH, prevRsiPH, pivBar, curHigh, rsiHighNear)
    bearClean := c
    bearMaxR  := m

bullReg = showReg and bullBase and bullClean and curLow < prevLowPL and rsiLowNear > prevRsiPL and (not needZone or bullMinR <= osLvl)
bearReg = showReg and bearBase and bearClean and curHigh > prevHighPH and rsiHighNear < prevRsiPH and (not needZone or bearMaxR >= obLvl)

// H 다이버전스: 시작점 RSI ≈ 50 (± midTol), 완성점 RSI가 과매도/과매수 도달
// 시작점은 바로 앞 저점(고점)만이 아니라, 범위 안의 이전 저점(고점)들 중 조건을 만족하는 가장 가까운 것
var array<int>   plBars  = array.new<int>()
var array<float> plVals  = array.new<float>()
var array<float> plRsis  = array.new<float>()
var array<int>   plRBars = array.new<int>()
var array<int>   phBars  = array.new<int>()
var array<float> phVals  = array.new<float>()
var array<float> phRsis  = array.new<float>()
var array<int>   phRBars = array.new<int>()

int   hbIdx = -1
int   hbX   = na
float hbP   = na
int   hbXR  = na
float hbR   = na
if showHid and showBull and plFound and rsiLowNear <= osLvl and array.size(plBars) > 0
    for k = array.size(plBars) - 1 to 0
        x1  = array.get(plBars, k)
        gap = pivBar - x1
        if gap > rangeMax
            break
        p1 = array.get(plVals, k)
        r1 = array.get(plRsis, k)
        if gap >= rangeMin and curLow > p1 and math.abs(r1 - 50) <= midTol
            [c, m] = checkLows(x1, p1, r1, pivBar, curLow, rsiLowNear)
            if c
                hbIdx := k
                hbX   := x1
                hbP   := p1
                hbXR  := array.get(plRBars, k)
                hbR   := r1
                break

int   hsIdx = -1
int   hsX   = na
float hsP   = na
int   hsXR  = na
float hsR   = na
if showHid and showBear and phFound and rsiHighNear >= obLvl and array.size(phBars) > 0
    for k = array.size(phBars) - 1 to 0
        x1  = array.get(phBars, k)
        gap = pivBar - x1
        if gap > rangeMax
            break
        p1 = array.get(phVals, k)
        r1 = array.get(phRsis, k)
        if gap >= rangeMin and curHigh < p1 and math.abs(r1 - 50) <= midTol
            [c, m] = checkHighs(x1, p1, r1, pivBar, curHigh, rsiHighNear)
            if c
                hsIdx := k
                hsX   := x1
                hsP   := p1
                hsXR  := array.get(phRBars, k)
                hsR   := r1
                break

bullHid = hbIdx >= 0
bearHid = hsIdx >= 0

// 이번 저점·고점을 기록 (최근 30개만 유지)
if plFound
    array.push(plBars, pivBar)
    array.push(plVals, curLow)
    array.push(plRsis, rsiLowNear)
    array.push(plRBars, rsiLowBar)
    if array.size(plBars) > 30
        array.shift(plBars)
        array.shift(plVals)
        array.shift(plRsis)
        array.shift(plRBars)
if phFound
    array.push(phBars, pivBar)
    array.push(phVals, curHigh)
    array.push(phRsis, rsiHighNear)
    array.push(phRBars, rsiHighBar)
    if array.size(phBars) > 30
        array.shift(phBars)
        array.shift(phVals)
        array.shift(phRsis)
        array.shift(phRBars)

// 가격 선: 가격 저점/고점끼리 · RSI 선: RSI 저점/고점끼리 (봉 위치가 1~2개 다를 수 있음)
drawDiv(int xp1, float p1, int xr1, float r1, int xp2, float p2, int xr2, float r2, color col, bool hidden, string txt, bool isBull) =>
    st = hidden ? line.style_dashed : regStyle
    lc = color.new(col, lineTr)
    lblStyle = isBull ? label.style_label_up : label.style_label_down
    lblTxt   = labelMode == "짧게" ? str.replace(txt, " 다이버전스", "") : txt
    if onRsiPane
        line.new(xr1, r1, xr2, r2, color = lc, style = st, width = lineW)
        if labelMode != "숨김"
            label.new(xr2, r2, lblTxt, color = color.new(col, 45), textcolor = color.white, size = lblSize, style = lblStyle)
    if onPrice
        line.new(xp1, p1, xp2, p2, color = lc, style = st, width = lineW, force_overlay = true)
        if labelMode != "숨김"
            label.new(xp2, p2, lblTxt, color = color.new(col, 45), textcolor = color.white, size = lblSize, style = lblStyle, yloc = isBull ? yloc.belowbar : yloc.abovebar, force_overlay = true)

if bullReg
    drawDiv(int(prevBarPL), prevLowPL, int(prevRBarPL), prevRsiPL, pivBar, curLow, rsiLowBar, rsiLowNear, cBull, false, "상승 다이버전스", true)
if bullHid
    drawDiv(hbX, hbP, hbXR, hbR, pivBar, curLow, rsiLowBar, rsiLowNear, cBull, true, "H 상승 다이버전스", true)
if bearReg
    drawDiv(int(prevBarPH), prevHighPH, int(prevRBarPH), prevRsiPH, pivBar, curHigh, rsiHighBar, rsiHighNear, cBear, false, "하락 다이버전스", false)
if bearHid
    drawDiv(hsX, hsP, hsXR, hsR, pivBar, curHigh, rsiHighBar, rsiHighNear, cBear, true, "H 하락 다이버전스", false)

// ───────────── 알림 ─────────────
alertcondition(bullReg, "상승 다이버전스", "TG: 상승 다이버전스 확정 (반등 가능성) — {{ticker}} {{interval}}")
alertcondition(bearReg, "하락 다이버전스", "TG: 하락 다이버전스 확정 (하락 가능성) — {{ticker}} {{interval}}")
alertcondition(bullHid, "H 상승 다이버전스", "TG: H 상승 다이버전스 (상승 추세 지속 가능성) — {{ticker}} {{interval}}")
alertcondition(bearHid, "H 하락 다이버전스", "TG: H 하락 다이버전스 (하락 추세 지속 가능성) — {{ticker}} {{interval}}")
